# Copy to .env and fill in what you have. Every key is optional:
# an empty key means that part runs on recorded demo data (mock mode).

# --- AI ---
# Claude: turns on the real agents (search, reading pages, analysis, strategy, chat).
ANTHROPIC_API_KEY=
# OpenAI: only used for embeddings ("you researched this before" memory). $50 hackathon credits.
OPENAI_API_KEY=

# Voice input (speech-to-text). ElevenLabs Scribe is used first; Gradium as an alternative.
ELEVENLABS_API_KEY=
GRADIUM_API_KEY=

# --- Web data ---
# Keenable: web search API for agents ($1,000 hackathon credits, code ACCEL-PARIS). Preferred search.
KEENABLE_API_KEY=
# Tavily web search. Without it, Claude's built-in web search tool is used.
TAVILY_API_KEY=
# Firecrawl, for pages that load content with JavaScript. Optional.
FIRECRAWL_API_KEY=
# Jina Reader works without a key; a key raises its rate limits. Optional.
JINA_API_KEY=
# H Company browser agents for hard pages. Needs both the key and the endpoint
# (check the H Platform docs tomorrow for the exact URL and request shape).
H_API_KEY=
H_API_URL=

# --- Aiven ---
# Aiven PostgreSQL service URI (must include ?sslmode=require). Empty = in-memory store.
DATABASE_URL=
# Aiven Valkey service URI (rediss://...). Empty = in-process cache.
VALKEY_URL=

# --- Deploy ---
# Token agents must send to /mcp (Authorization: Bearer <token> or ?token=). Set it on public deploys.
MCP_TOKEN=

# --- Models (defaults shown) ---
# MODEL_SCOUT=claude-opus-5-5
# MODEL_EXTRACT=claude-opus-5-5     # set claude-haiku-5-5 for faster, cheaper page reading
# MODEL_ANALYST=claude-opus-5-5
# MODEL_STRATEGIST=claude-opus-5-5
# MODEL_CHAT=claude-opus-5-5

# EFFORT_SCOUT=low / EFFORT_ANALYST=low / EFFORT_STRATEGIST=low   (low|medium|high)

# --- Tuning ---
# MAX_COMPETITORS=8
# PAGES_PER_COMPANY=4
# HUNT_TIMEOUT_S=180
# RESEARCHER_TIMEOUT_S=30
# H_CONCURRENCY=3          # H free plan allows 3 sessions at once
# MEMORY_THRESHOLD=0.6
# MOCK_DELAY=1             # speed of recorded runs (0 = instant)
# SEED_DEMO=1              # load 2 recorded researches on startup
# WATCH_INTERVAL_MIN=0     # Watcher schedule in minutes (0 = only on demand)
# UPGRADE_INTERVAL_MIN=10  # Upgrader agent: enrich the stalest research every N minutes (0 = off)
